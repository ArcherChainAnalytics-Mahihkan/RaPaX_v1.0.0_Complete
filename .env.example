# ─────────────────────────────────────────────
#  RaPaX™ Environment Configuration
# ─────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development
OPERATOR_SECRET=change_this_to_a_long_random_string

# Database
DB_PATH=./rapax.db

# Storage Paths
PRODUCTS_DIR=./storage/products
FINGERPRINTED_DIR=./storage/fingerprinted
LOGS_DIR=./logs

# JWT
JWT_SECRET=change_this_jwt_secret
JWT_EXPIRES_IN=24h

# Download Link TTL (seconds)
DOWNLOAD_LINK_TTL=3600

# AcerbE™ Fingerprinting Service
ACERBE_BASE_URL=http://localhost:5000
ACERBE_API_KEY=acerbe_api_key_here

# ─── Blockchain Providers ─────────────────────

# BTC (BlockCypher or your own node)
BTC_NETWORK=mainnet
BTC_API_PROVIDER=blockcypher
BTC_API_TOKEN=your_blockcypher_token
BTC_XPUB=your_btc_xpub_key

# ETH (Alchemy / Infura / own node)
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
ETH_CONFIRMATIONS_REQUIRED=2

# SOL (Helius / QuickNode / own node)
SOL_RPC_URL=https://api.mainnet-beta.solana.com
SOL_CONFIRMATIONS_REQUIRED=1

# USDT (ERC20 — same provider as ETH)
USDT_CONTRACT_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7

# ─── FIAT (Future — Do NOT activate) ──────────
FIAT_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
